<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Syntetisk testkart</name>
    <description>Et lite kart som dekker parserens viktigste formater.</description>
    <Style id="icon-1623-FFFFFF">
      <IconStyle>
        <color>ff007cf5</color>
        <Icon><href>https://www.gstatic.com/mapspro/images/stock/503-wht-blank_maps.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="icon-1577-FFFFFF">
      <IconStyle>
        <color>ff3f5b9a</color>
        <Icon><href>https://www.gstatic.com/mapspro/images/stock/503-wht-blank_maps.png</href></Icon>
      </IconStyle>
    </Style>
    <Style id="route-style">
      <LineStyle><color>ff4d7239</color><width>3</width></LineStyle>
    </Style>
    <Folder>
      <name>Teststeder</name>
      <Placemark>
        <name>Testbukta</name>
        <styleUrl>#icon-1623-FFFFFF</styleUrl>
        <description><![CDATA[Coordinates: 60.00 N, 10.00 E<br>Sea bed: Sand<br>Wind Protection: Sheltered<br>En rolig testbeskrivelse.]]></description>
        <Point><coordinates>10.0,60.0,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Testrestaurant</name>
        <styleUrl>#icon-1577-FFFFFF</styleUrl>
        <ExtendedData>
          <Data name="description"><value>Serverer testmat.</value></Data>
          <Data name="booking"><value>Ikke nødvendig.</value></Data>
        </ExtendedData>
        <Point><coordinates>10.1,60.1,0</coordinates></Point>
      </Placemark>
      <Folder>
        <name>Testdag 1</name>
        <Placemark>
          <name>Testhavn</name>
          <styleUrl>#icon-1623-FFFFFF</styleUrl>
          <Point><coordinates>10.2,60.2,0</coordinates></Point>
        </Placemark>
        <Placemark>
          <name>Testrute</name>
          <styleUrl>#route-style</styleUrl>
          <LineString><coordinates>10.0,60.0,0 10.1,60.1,0 10.2,60.2,0</coordinates></LineString>
        </Placemark>
      </Folder>
    </Folder>
  </Document>
